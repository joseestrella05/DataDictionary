    private async Task GenerateAndDownloadDictionary()
    {
        if (string.IsNullOrWhiteSpace(SelectedDatabase))
        {
            ErrorMessage = "Debe seleccionar una base de datos.";
            return;
        }

        var selectedTables = SchemaGroups
            .SelectMany(g => g.Tables)
            .Where(t => t.IsSelected)
            .Select(t => t.FullName)
            .ToList();

        if (selectedTables.Count == 0)
        {
            ErrorMessage = "Debe seleccionar al menos una tabla para documentar.";
            return;
        }

        IsGenerating = true;
        ErrorMessage = null;
        SuccessMessage = null;
        var sw = System.Diagnostics.Stopwatch.StartNew();

        try
        {
            // Fase 1: Extracción Server-Side con READ UNCOMMITTED
            ProgressPhase = "Fase 1/3: Extracción de Metadatos SQL Server";
            ProgressDetail = $"Consultando metadatos y relaciones de {selectedTables.Count} tablas con aislamiento READ UNCOMMITTED...";
            ProgressPercent = 30;
            StateHasChanged();
            await Task.Delay(50);

            var metadata = await ExtractionService.ExtractEnrichedMetadataAsync(Connection, SelectedDatabase, selectedTables);

            // Enriquecer automáticamente con sugerencias del glosario
            if (MasterGlossary.Count == 0)
            {
                MasterGlossary = await IntelligentService.GetGlossaryItemsAsync(Connection, SelectedDatabase);
            }
            IntelligentService.EnrichWithSuggestions(metadata, MasterGlossary);

            // Cargar historial formal de campos deprecados / eliminados
            metadata.DeprecatedFields = await DriftService.GetDeprecatedFieldsAsync(Connection, SelectedDatabase);

            // Cargar historial de modificaciones estructurales y control de versiones
            metadata.VersionHistory = await DriftService.GetAllVersionHistoryAsync(Connection, SelectedDatabase);

            // Fase 2: Compilación OpenXML con Streaming de Archivo Temporal
            ProgressPhase = "Fase 2/3: Compilando Documento Word OpenXML";
            ProgressDetail = $"Estructurando {metadata.TotalColumns} columnas, relaciones PK/FK, historial de eliminaciones y jerarquía visual...";
            ProgressPercent = 70;
            StateHasChanged();
            await Task.Delay(50);

            string tempFile = WordService.GenerateDocumentToTempFile(metadata, Customization);
            var fileInfo = new FileInfo(tempFile);

            // Fase 3: Streaming HTTP de Alta Velocidad
            ProgressPhase = "Fase 3/3: Transfiriendo Archivo al Navegador";
            ProgressDetail = $"Iniciando descarga HTTP ({fileInfo.Length / 1024.0:F1} KB)...";
            ProgressPercent = 95;
            StateHasChanged();
            await Task.Delay(50);

            string downloadFileName = $"Diccionario_Datos_{SelectedDatabase}_{DateTime.Now:yyyyMMdd_HHmmss}.docx";
            string token = DownloadManager.RegisterTempFile(tempFile, downloadFileName);

            // Disparar descarga directa nativa mediante la URL del endpoint
            await JS.InvokeVoidAsync("downloadFileFromUrl", $"/api/download/{token}");

            sw.Stop();
            ProgressPercent = 100;
            SuccessMessage = $"¡Diccionario generado con éxito! Archivo: '{downloadFileName}' ({fileInfo.Length / 1024.0:F1} KB, {metadata.TotalColumns} columnas y {metadata.DeprecatedFields.Count} campos eliminados documentados en {sw.ElapsedMilliseconds} ms).";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error en la generación del documento: {ex.Message}";
        }
        finally
        {
            IsGenerating = false;
        }
    }
