    private List<ColumnMetadata> GetFilteredColumns(TableMetadata table)
    {
        var query = table.Columns.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(AuditFilterText))
        {
            string f = AuditFilterText.Trim();
            query = query.Where(c => c.Name.Contains(f, StringComparison.OrdinalIgnoreCase) || 
                                     c.EditableDescription.Contains(f, StringComparison.OrdinalIgnoreCase));
        }

        switch (AuditStatusFilter)
        {
            case "UNDOCUMENTED":
                query = query.Where(c => !c.HasExistingDescription);
                break;
            case "GLOSSARY":
                query = query.Where(c => !c.HasExistingDescription && c.SuggestionSource == SuggestionSourceType.MasterGlossary);
                break;
            case "FK":
                query = query.Where(c => !c.HasExistingDescription && c.SuggestionSource == SuggestionSourceType.ForeignKeyReference);
                break;
            case "SEMANTIC":
                query = query.Where(c => !c.HasExistingDescription && c.SuggestionSource == SuggestionSourceType.SemanticReuse);
                break;
            case "INFERRED":
                query = query.Where(c => !c.HasExistingDescription && c.SuggestionSource == SuggestionSourceType.PatternInference);
                break;
        }

        return query.ToList();
    }

    private async Task HandleLogoUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);

                Customization.LogoBytes = ms.ToArray();
                Customization.LogoFileName = file.Name;
                Customization.LogoContentType = file.ContentType;
            }
            catch (Exception ex)
            {
                ErrorMessage = $"Error al procesar logotipo: {ex.Message}";
            }
        }
    }

