    private async Task LoadAuditDataAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedDatabase))
        {
            ErrorMessage = "Debe conectarse y seleccionar una base de datos primero.";
            return;
        }

        var selectedTables = SchemaGroups
            .SelectMany(g => g.Tables)
            .Where(t => t.IsSelected)
            .Select(t => t.FullName)
            .ToList();

        if (selectedTables.Count == 0)
        {
            selectedTables = SchemaGroups
                .SelectMany(g => g.Tables)
                .Select(t => t.FullName)
                .ToList();
        }

        if (selectedTables.Count == 0)
        {
            ErrorMessage = "No hay tablas disponibles en la base de datos para auditar.";
            return;
        }

        IsLoadingAudit = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            MasterGlossary = await IntelligentService.GetGlossaryItemsAsync(Connection, SelectedDatabase);
            AuditDictionary = await ExtractionService.ExtractEnrichedMetadataAsync(Connection, SelectedDatabase, selectedTables);
            IntelligentService.EnrichWithSuggestions(AuditDictionary, MasterGlossary);

            SuccessMessage = $"Auditoría completada para '{SelectedDatabase}': {AuditDictionary.TotalColumns} columnas evaluadas ({CountDocumented} documentadas, {AuditDictionary.TotalUndocumentedColumns} sugeridas).";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error durante la auditoría de metadatos: {ex.Message}";
        }
        finally
        {
            IsLoadingAudit = false;
        }
    }

    private void ApplyAllSuggestions()
    {
        if (AuditDictionary == null) return;

        int count = 0;
        foreach (var schema in AuditDictionary.Schemas)
        {
            foreach (var table in schema.Tables)
            {
                if (!table.HasExistingDescription && !string.IsNullOrWhiteSpace(table.SuggestedDescription))
                {
                    table.EditableDescription = table.SuggestedDescription;
                    table.IsDirty = true;
                    count++;
                }

                foreach (var col in table.Columns)
                {
                    if (!col.HasExistingDescription && !string.IsNullOrWhiteSpace(col.SuggestedDescription))
                    {
                        col.EditableDescription = col.SuggestedDescription;
                        col.IsDirty = true;
                        count++;
                    }
                }
            }
        }

        SuccessMessage = $"Se aplicaron las sugerencias inteligentes a {count} elementos indocumentados en memoria. Pulse 'Guardar Descripciones en BD' para fijarlas en SQL Server.";
    }

