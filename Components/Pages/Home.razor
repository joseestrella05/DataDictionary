    private async Task ConnectAndFetchDatabases()
    {
        ErrorMessage = null;
        SuccessMessage = null;
        IsConnecting = true;
        ServerInfo = null;

        try
        {
            var (success, msg, version) = await DiscoveryService.TestConnectionAsync(Connection);
            if (!success)
            {
                ErrorMessage = msg;
                return;
            }

            ServerInfo = $"{msg}";
            Databases = await DiscoveryService.GetDatabasesAsync(Connection);
            SchemaGroups.Clear();
            SelectedDatabase = null;
            AuditDictionary = null;
            DriftAlerts.Clear();

            if (Databases.Count == 0)
            {
                ErrorMessage = "Conectado al servidor, pero no se encontraron bases de datos de usuario con permisos de lectura.";
            }
            else
            {
                SuccessMessage = $"Conexión establecida. {Databases.Count} bases de datos de usuario detectadas.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al conectar con SQL Server: {ex.Message}";
        }
        finally
        {
            IsConnecting = false;
        }
    }

    private async Task OnDatabaseSelected(ChangeEventArgs e)
    {
        SelectedDatabase = e.Value?.ToString();
        SchemaGroups.Clear();
        ErrorMessage = null;
        SuccessMessage = null;
        SearchFilter = string.Empty;
        AuditDictionary = null;
        DriftAlerts.Clear();

        if (string.IsNullOrWhiteSpace(SelectedDatabase))
        {
            return;
        }

        Customization.DocumentTitle = $"Diccionario de Datos de la Base de Datos {SelectedDatabase}";
        IsLoadingTables = true;

        try
        {
            SchemaGroups = await DiscoveryService.GetTablesForDatabaseAsync(Connection, SelectedDatabase);
            SuccessMessage = $"Catálogo de '{SelectedDatabase}' cargado: {TotalTableCount} tablas en {SchemaGroups.Count} esquemas.";

            // Asegurar que las tablas de auditoría y versiones existan de inmediato en la BD seleccionada
            await DriftService.EnsureAuditTablesExistAsync(Connection, SelectedDatabase);

            // Cargar estado de snapshot, glosario, historial de deprecados y versiones
            var (exists, date, cols) = await DriftService.GetSnapshotInfoAsync(Connection, SelectedDatabase);
            HasActiveSnapshot = exists;
            SnapshotDate = date;
            SnapshotColumnCount = cols;

            // Si no existe snapshot previo o está vacío, registrar línea base automáticamente
            if (!HasActiveSnapshot || SnapshotColumnCount == 0)
            {
                var allTableNames = SchemaGroups.SelectMany(g => g.Tables).Select(t => t.FullName).ToList();
                if (allTableNames.Count > 0)
                {
                    var meta = await ExtractionService.ExtractEnrichedMetadataAsync(Connection, SelectedDatabase, allTableNames);
                    var tList = meta.Schemas.SelectMany(s => s.Tables).ToList();
                    SnapshotColumnCount = await DriftService.TakeSnapshotAsync(Connection, SelectedDatabase, tList);
                    HasActiveSnapshot = true;
                    SnapshotDate = DateTime.Now;
                }
            }

            DeprecatedHistory = await DriftService.GetDeprecatedFieldsAsync(Connection, SelectedDatabase);
            VersionHistoryList = await DriftService.GetAllVersionHistoryAsync(Connection, SelectedDatabase);
            MasterGlossary = await IntelligentService.GetGlossaryItemsAsync(Connection, SelectedDatabase);

            // Ejecutar comparación automática contra snapshot para detectar cambios inmediatamente
            await CheckSchemaDriftAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al consultar catálogo de '{SelectedDatabase}': {ex.Message}";
        }
        finally
        {
            IsLoadingTables = false;
            // Update navbar connection indicator
            await JS.InvokeVoidAsync("setNavDbStatus", SelectedDatabase, !string.IsNullOrEmpty(SelectedDatabase));
        }
    }

