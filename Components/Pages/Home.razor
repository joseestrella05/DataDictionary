    private async Task TakeSnapshotAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedDatabase)) return;

        var selectedTables = SchemaGroups
            .SelectMany(g => g.Tables)
            .Where(t => t.IsSelected)
            .Select(t => t.FullName)
            .ToList();

        if (selectedTables.Count == 0)
        {
            selectedTables = SchemaGroups
                .SelectMany(g => g.Tables)
                .Select(t => t.FullName)
                .ToList();
        }

        if (selectedTables.Count == 0)
        {
            ErrorMessage = "Debe seleccionar o tener al menos una tabla disponible para registrar el snapshot.";
            return;
        }

        IsTakingSnapshot = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var currentMetadata = await ExtractionService.ExtractEnrichedMetadataAsync(Connection, SelectedDatabase, selectedTables);
            var tablesList = currentMetadata.Schemas.SelectMany(s => s.Tables).ToList();

            int count = await DriftService.TakeSnapshotAsync(Connection, SelectedDatabase, tablesList);
            HasActiveSnapshot = true;
            SnapshotDate = DateTime.Now;
            SnapshotColumnCount = count;

            SuccessMessage = $"Snapshot de esquema registrado con éxito: {count} columnas guardadas como línea base en 'dbo.Diccionario_Snapshot'.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al registrar snapshot: {ex.Message}";
        }
        finally
        {
            IsTakingSnapshot = false;
        }
    }

    private async Task CheckSchemaDriftAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedDatabase)) return;

        var selectedTables = SchemaGroups
            .SelectMany(g => g.Tables)
            .Where(t => t.IsSelected)
            .Select(t => t.FullName)
            .ToList();

        if (selectedTables.Count == 0)
        {
            selectedTables = SchemaGroups
                .SelectMany(g => g.Tables)
                .Select(t => t.FullName)
                .ToList();
        }

        if (selectedTables.Count == 0)
        {
            ErrorMessage = "No hay tablas disponibles en la base de datos para comparar contra el snapshot.";
            return;
        }

        IsCheckingDrift = true;
        ErrorMessage = null;
        SuccessMessage = null;

        try
        {
            var currentMetadata = await ExtractionService.ExtractEnrichedMetadataAsync(Connection, SelectedDatabase, selectedTables);
            var tablesList = currentMetadata.Schemas.SelectMany(s => s.Tables).ToList();

            DriftAlerts = await DriftService.DetectDriftAsync(Connection, SelectedDatabase, tablesList);
            DeprecatedHistory = await DriftService.GetDeprecatedFieldsAsync(Connection, SelectedDatabase);
            VersionHistoryList = await DriftService.GetAllVersionHistoryAsync(Connection, SelectedDatabase);

            if (DriftAlerts.Count == 0)
            {
                SuccessMessage = "Auditoría de esquema completada: 0 discrepancias detectadas. El esquema físico coincide exactamente con el Snapshot.";
            }
            else
            {
                SuccessMessage = $"Auditoría completada: se detectaron {DriftAlerts.Count} diferencias ({CountDeletedDrift} eliminaciones, {CountModifiedDrift} modificaciones, {CountNewDrift} campos nuevos).";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error al contrastar esquema con snapshot: {ex.Message}";
        }
        finally
        {
            IsCheckingDrift = false;
        }
    }

